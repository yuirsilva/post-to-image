{
  "name": "postcard-instagram-to-image",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "format": "prettier --write \"{src/**/*.{ts,tsx,css},server.ts,vite.config.ts}\"",
    "format:check": "prettier --check \"{src/**/*.{ts,tsx,css},server.ts,vite.config.ts}\"",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "html-to-image": "^1.11.13",
    "motion": "^13.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^7.1.1"
  }
}
