# Paste the Cookie request header from an authenticated instagram.com browser request.
# Keep this file private. Never add a real value to source control.
INSTAGRAM_COOKIE="sessionid=...; csrftoken=...; ds_user_id=..."

# Optional. Match the browser session that produced the cookie.
INSTAGRAM_USER_AGENT="Mozilla/5.0 ..."

# Optional. Public X posts are loaded without authentication first.
# Set this only when X requires a signed-in session for a post.
X_COOKIE="auth_token=...; ct0=..."

# Optional. Match the browser session that produced the X cookie.
X_USER_AGENT="Mozilla/5.0 ..."
